# Copy this file to .env and fill in your LangSmith API key to enable tracing.
# Get a key at https://smith.langchain.com -> Settings -> API Keys.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-werewolf
# Only needed if your LangSmith workspace is hosted in the EU region
# (check Settings -> your org, or try without this first):
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
